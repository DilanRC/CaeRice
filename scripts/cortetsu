#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
DATA_ROOT="${CORTETSU_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/cortetsu}"
RUNTIME_ROOT="${CORTETSU_RUNTIME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/cortetsu}"
CURRENT="$RUNTIME_ROOT/current"
PREVIOUS="$RUNTIME_ROOT/previous"
LEGACY_PREVIOUS="$RUNTIME_ROOT/legacy-previous"

find_repo_root() {
    local candidate="" git_root=""
    local candidates=()
    [[ -z "${CORTETSU_REPO_ROOT:-}" ]] || candidates+=("$CORTETSU_REPO_ROOT")
    candidates+=("$SCRIPT_DIR/..")
    [[ ! -e "$DATA_ROOT/repository" && ! -L "$DATA_ROOT/repository" ]] || candidates+=("$DATA_ROOT/repository")
    git_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -z "$git_root" ]] || candidates+=("$git_root")
    for candidate in "${candidates[@]}"; do
        candidate="$(readlink -f "$candidate" 2>/dev/null || true)"
        if [[ -n "$candidate" && -f "$candidate/cortetsu.toml" && -f "$candidate/scripts/cortetsu" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ROOT="$(find_repo_root || true)"
BASE_INFO="${ROOT:+$ROOT/caelestia/PATCH_BASE_INFO.txt}"

usage() {
    cat <<'EOF'
Cortetsu command entrypoint

Usage:
  cortetsu status                  Show repository, shell and dotfiles generations
  cortetsu plan                    Preview dotfiles adoption without writing
  cortetsu apply                   Build and promote a dotfiles generation
  cortetsu doctor [--json]         Check packages, runtime, dotfiles and services
  cortetsu dotfiles <action>       plan|apply|verify|status|rollback|gc
  cortetsu test                    Run repository, UX and transaction regressions
  cortetsu verify                  Verify shell + dotfiles promoted generations
  cortetsu audit                   Run status, doctor, tests and verification
  cortetsu install                 Build shell and apply a verified dotfiles generation
  cortetsu help                    Show this help
EOF
}

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
require_repo() { [[ -n "$ROOT" ]] || fail "no se encontró el repositorio Cortetsu; ejecuta desde el clon o define CORTETSU_REPO_ROOT"; }
require_file() { [[ -f "$1" ]] || fail "falta archivo requerido: $1"; }
resolved_generation() { readlink -f "$1" 2>/dev/null || true; }

is_managed_generation() {
    local root="$1" required
    [[ -n "$root" ]] || return 1
    for required in shell.qml BUILD_ID BUILD.json compatibility.json composition.json modules/BottomHub.qml modules/calendar/Content.qml modules/calendar/Wrapper.qml; do
        [[ -f "$root/$required" ]] || return 1
    done
}

show_generation() {
    local label="$1" link="$2" resolved
    resolved="$(resolved_generation "$link")"
    if [[ -z "$resolved" || ! -f "$resolved/shell.qml" ]]; then
        printf '  %s=missing\n' "$label"
        return
    fi
    printf '  %s=%s\n' "$label" "$resolved"
    if ! is_managed_generation "$resolved"; then
        printf '  %s_metadata=archived-unmanaged\n' "$label"
        return
    fi
    printf '  %s_build_id=%s\n' "$label" "$(tr -d '\n' < "$resolved/BUILD_ID")"
    python3 - "$label" "$resolved/BUILD.json" <<'PY'
import json, sys
from pathlib import Path
label, path = sys.argv[1:]
try:
    payload = json.loads(Path(path).read_text(encoding="utf-8"))
except (OSError, ValueError):
    print(f"  {label}_metadata=invalid")
else:
    print(f"  {label}_upstream={payload.get('upstreamTag', 'unknown')}@{payload.get('upstreamCommit', 'unknown')}")
    print(f"  {label}_revision={payload.get('repositoryRevision', 'unknown')}")
PY
}

dotfiles_cmd() {
    require_repo
    require_file "$ROOT/core/dotfiles.py"
    local action="${1:-status}"
    shift || true
    python3 "$ROOT/core/dotfiles.py" "$action" --repo "$ROOT" "$@"
}

status_cmd() {
    printf 'Cortetsu\nRoot: %s\nStage: dotfiles-foundation\n' "${ROOT:-unavailable}"
    if [[ -n "$BASE_INFO" && -f "$BASE_INFO" ]]; then
        printf '\nShell base contract:\n'; sed 's/^/  /' "$BASE_INFO"
    fi
    if [[ -n "$ROOT" ]] && git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch revision dirty
        branch="$(git -C "$ROOT" branch --show-current)"
        revision="$(git -C "$ROOT" rev-parse --short HEAD)"
        [[ -z "$(git -C "$ROOT" status --porcelain)" ]] && dirty=no || dirty=yes
        printf '\nGit:\n  branch=%s\n  revision=%s\n  dirty=%s\n' "${branch:-detached}" "$revision" "$dirty"
    fi
    printf '\nRuntime generations:\n  root=%s\n' "$RUNTIME_ROOT"
    show_generation current "$CURRENT"
    show_generation previous "$PREVIOUS"
    if [[ -e "$LEGACY_PREVIOUS" || -L "$LEGACY_PREVIOUS" ]]; then show_generation archived_previous "$LEGACY_PREVIOUS"; fi
    printf '  package_reference=/etc/xdg/quickshell/caelestia (read-only)\n'
    if [[ -n "$ROOT" && -f "$ROOT/core/dotfiles.py" ]]; then
        printf '\n'
        dotfiles_cmd status
    fi
    printf '\nCanonical namespace:\n  commands=cortetsu-*\n  config=~/.config/cortetsu\n  state=~/.local/state/cortetsu\n  data=~/.local/share/cortetsu\n'
}

run_python_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; python3 "$ROOT/$relative"; }
run_bash_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; bash "$ROOT/$relative"; }

test_cmd() {
    require_repo
    local tests=(
        "scripts/features/test-bottom-hub-target.py"
        "scripts/features/test-bottom-hub-v3.py"
        "scripts/features/test-bottom-hub-v4.py"
        "scripts/features/test-retained-overlay-wiring.py"
        "scripts/features/test-contentwindow-overview-base.py"
        "scripts/features/test-wallpaper-manager.py"
        "scripts/features/test-keybinds.py"
        "scripts/features/eval-keybind-editor.py"
        "scripts/features/test-shell-normalizer.py"
        "scripts/features/test-cortetsu-quality.py"
        "scripts/features/test-dotfiles-platform.py"
        "caelestia/tests/test-calendar-credentials.py"
        "caelestia/tests/test-calendar-polish.py"
        "caelestia/tests/test-pomodoro.py"
        "caelestia/tests/test-runtime-contract.py"
    )
    local test_path
    for test_path in "${tests[@]}"; do run_python_test "$test_path"; done
    run_bash_test "scripts/features/test-v2-migration-unreadable.sh"
    run_bash_test "scripts/features/test-upstream-bootstrap.sh"
    run_bash_test "caelestia/tests/test-calendar-readonly.sh"
    printf '\nCortetsu repository regressions passed.\n'
}

verify_generation() {
    local label="$1" link="$2" resolved
    resolved="$(resolved_generation "$link")"
    [[ -n "$resolved" ]] || fail "no existe la generación $label: $link"
    is_managed_generation "$resolved" || fail "$label no es una generación Cortetsu administrada: $resolved"
    python3 - "$resolved/BUILD.json" "$ROOT/caelestia/compatibility.json" <<'PY'
import json, sys
from pathlib import Path
build_path, contract_path = map(Path, sys.argv[1:])
build = json.loads(build_path.read_text(encoding="utf-8"))
contract = json.loads(contract_path.read_text(encoding="utf-8"))["caelestiaShell"]
assert build.get("schema") == 1
assert build.get("upstreamTag") == contract["upstreamTag"]
assert build.get("upstreamCommit") == contract["upstreamCommit"]
assert isinstance(build.get("repositoryRevision"), str) and build["repositoryRevision"]
PY
    printf 'PASS: %s generation %s\n' "$label" "$resolved"
}

verify_cmd() {
    require_repo
    require_file "$ROOT/caelestia/compatibility.json"
    verify_generation current "$CURRENT"
    local current_resolved previous_resolved archived_resolved
    current_resolved="$(resolved_generation "$CURRENT")"
    if [[ -e "$PREVIOUS" || -L "$PREVIOUS" ]]; then
        previous_resolved="$(resolved_generation "$PREVIOUS")"
        if is_managed_generation "$previous_resolved"; then
            verify_generation previous "$PREVIOUS"
            [[ "$current_resolved" != "$previous_resolved" ]] || fail "current y previous apuntan a la misma generación"
        elif [[ -n "$previous_resolved" && -f "$previous_resolved/shell.qml" ]]; then
            printf 'WARN: previous pre-v2 detectado; cortetsu install lo archivará fuera del rollback automático: %s\n' "$previous_resolved" >&2
        fi
    fi
    if [[ -e "$LEGACY_PREVIOUS" || -L "$LEGACY_PREVIOUS" ]]; then
        archived_resolved="$(resolved_generation "$LEGACY_PREVIOUS")"
        [[ -z "$archived_resolved" || ! -f "$archived_resolved/shell.qml" ]] || printf 'INFO: snapshot pre-v2 archivado: %s\n' "$archived_resolved"
    fi
    run_python_test "scripts/features/test-cortetsu-quality.py"
    run_python_test "caelestia/tests/test-runtime-contract.py"
    run_bash_test "caelestia/tests/test-calendar-readonly.sh"
    dotfiles_cmd verify
    printf '\nCortetsu promoted runtime and dotfiles verified.\n'
}

doctor_cmd() {
    require_repo
    require_file "$ROOT/core/doctor.py"
    python3 "$ROOT/core/doctor.py" --repo "$ROOT" "$@"
}

plan_cmd() { dotfiles_cmd plan "$@"; }
apply_cmd() { dotfiles_cmd apply "$@"; }
audit_cmd() { require_repo; status_cmd; printf '\n===== DOCTOR =====\n'; doctor_cmd; printf '\n===== REPOSITORY TESTS =====\n'; test_cmd; printf '\n===== PROMOTED SYSTEM =====\n'; verify_cmd; }
install_cmd() { require_repo; require_file "$ROOT/scripts/install-cortetsu.sh"; printf 'Cortetsu: building shell and dotfiles generations.\n'; bash "$ROOT/scripts/install-cortetsu.sh"; }

command="${1:-help}"
shift || true
case "$command" in
    status) status_cmd "$@" ;;
    plan) plan_cmd "$@" ;;
    apply) apply_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    dotfiles) dotfiles_cmd "$@" ;;
    test) test_cmd "$@" ;;
    verify) verify_cmd "$@" ;;
    audit) audit_cmd "$@" ;;
    install) install_cmd "$@" ;;
    help|-h|--help) usage ;;
    *) printf 'ERROR: unknown command: %s\n\n' "$command" >&2; usage >&2; exit 64 ;;
esac
