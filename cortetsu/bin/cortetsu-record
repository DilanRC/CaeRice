#!/usr/bin/env python3
"""First-party GPU Screen Recorder controller for Cortetsu."""
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

RECORDER = "gpu-screen-recorder"
HOME = Path.home()

def xdg(name: str, fallback: Path) -> Path:
    return Path(os.environ.get(name, str(fallback)))

STATE_DIR = xdg("XDG_STATE_HOME", HOME / ".local/state") / "cortetsu/record"
VIDEOS_DIR = xdg("XDG_VIDEOS_DIR", HOME / "Videos")
RECORDINGS_DIR = xdg("CORTETSU_RECORDINGS_DIR", VIDEOS_DIR / "Recordings")
RECORDING_PATH = STATE_DIR / "recording.mp4"
NOTIF_PATH = STATE_DIR / "notifid.txt"
CONFIG_PATH = xdg("XDG_CONFIG_HOME", HOME / ".config") / "cortetsu/cli.json"

def recorder_pids() -> list[int]:
    result = subprocess.run(["pidof", RECORDER], text=True, capture_output=True)
    return [int(pid) for pid in result.stdout.split() if pid.isdigit()] if result.returncode == 0 else []

def signal_recorders(signum: signal.Signals) -> None:
    for pid in recorder_pids():
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass

def notify(*args: str, wait: bool = False) -> str:
    command = ["notify-send", "-a", "cortetsu", *args]
    if wait:
        return subprocess.check_output(command, text=True).strip()
    subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return ""

def close_notification(notification_id: str) -> None:
    if notification_id:
        subprocess.run(["gdbus", "call", "--session", "--dest=org.freedesktop.Notifications", "--object-path=/org/freedesktop/Notifications", "--method=org.freedesktop.Notifications.CloseNotification", notification_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def load_config() -> dict:
    try:
        return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def parse_monitors(output: str) -> set[str]:
    return {line.split("|", 1)[0].strip() for line in output.splitlines() if line.strip()}

def capture_target(focused: str, available: set[str]) -> str:
    return focused if focused in available else "screen"

def intersects(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return a[0] < b[0] + b[2] and a[0] + a[2] > b[0] and a[1] < b[1] + b[3] and a[1] + a[3] > b[1]

def start_args(args: argparse.Namespace) -> list[str]:
    monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"], text=True))
    command = ["-w"]
    if args.region:
        region = subprocess.check_output(["slurp", "-f", "%wx%h+%x+%y"], text=True).strip() if args.region == "slurp" else args.region
        match = re.fullmatch(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", region.strip())
        if not match:
            raise ValueError(f"Invalid region: {region}")
        width, height, x_pos, y_pos = map(int, match.groups())
        selected = (x_pos, y_pos, width, height)
        fps = max((round(m["refreshRate"]) for m in monitors if intersects((m["x"], m["y"], m["width"], m["height"]), selected)), default=60)
        command += ["region", "-region", region.strip(), "-f", str(fps)]
    else:
        focused = next(m for m in monitors if m["focused"])
        listed = subprocess.run([RECORDER, "--list-monitors"], text=True, capture_output=True)
        available = parse_monitors(listed.stdout + listed.stderr) | {"screen"}
        command += [capture_target(focused["name"], available), "-f", str(round(focused["refreshRate"]))]
    if args.sound:
        command += ["-a", "default_output"]
    extra = load_config().get("record", {}).get("extraArgs", [])
    if not isinstance(extra, list):
        raise ValueError("Config option 'record.extraArgs' should be an array")
    return command + [str(value) for value in extra]

def start(args: argparse.Namespace) -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    command = [RECORDER, *start_args(args), "-o", str(RECORDING_PATH)]
    process = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        if process.wait(1) != 0:
            notify("Recording failed", f"Command failed with exit code {process.returncode}")
            return process.returncode or 1
    except subprocess.TimeoutExpired:
        pass
    NOTIF_PATH.write_text(notify("-p", "Recording started", "Recording...", wait=True), encoding="utf-8")
    return 0

def stop(args: argparse.Namespace) -> int:
    signal_recorders(signal.SIGINT)
    deadline = time.monotonic() + 5
    while recorder_pids() and time.monotonic() < deadline:
        time.sleep(0.1)
    if not RECORDING_PATH.exists():
        notify("Recording failed", f"No temporary recording was written at {RECORDING_PATH}")
        return 1
    RECORDINGS_DIR.mkdir(parents=True, exist_ok=True)
    new_path = RECORDINGS_DIR / f"recording_{datetime.now().strftime('%Y%m%d_%H-%M-%S')}.mp4"
    shutil.move(RECORDING_PATH, new_path)
    try:
        close_notification(NOTIF_PATH.read_text(encoding="utf-8"))
    except OSError:
        pass
    if args.clipboard:
        subprocess.run(["wl-copy", "--type", "text/uri-list"], input=(new_path.resolve().as_uri() + "\n").encode(), check=False)
    notify("Recording stopped", f"Recording saved in {new_path}")
    print(new_path)
    return 0

def self_test() -> None:
    assert parse_monitors("eDP-1|1920x1080\n") == {"eDP-1"}
    assert capture_target("eDP-1", {"screen", "eDP-1"}) == "eDP-1"
    assert capture_target("HDMI-A-1", {"screen", "eDP-1"}) == "screen"

def main() -> int:
    parser = argparse.ArgumentParser(prog="cortetsu-record")
    parser.add_argument("action", nargs="?", choices=["status", "start", "stop", "pause"], default="status")
    parser.add_argument("-r", "--region", nargs="?", const="slurp")
    parser.add_argument("-s", "--sound", action="store_true")
    parser.add_argument("-p", "--pause", action="store_true")
    parser.add_argument("-c", "--clipboard", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return 0
    if args.pause:
        signal_recorders(signal.SIGUSR2)
        return 0
    if args.action == "status":
        return 0 if recorder_pids() else 1
    if args.action == "stop" or recorder_pids():
        return stop(args)
    return start(args)

if __name__ == "__main__":
    sys.exit(main())
