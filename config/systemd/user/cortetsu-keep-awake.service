[Unit]
Description=Keep the Cortetsu desktop session awake
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --who=Cortetsu --why=Cortetsu-session-keep-awake --mode=block /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
