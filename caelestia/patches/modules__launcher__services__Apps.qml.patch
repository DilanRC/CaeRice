-                workingDirectory: entry.workingDirectory
-            });
+            root.launchInScope(entry, [...GlobalConfig.general.apps.terminal, `${Quickshell.shellDir}/assets/wrap_term_launch.sh`, ...entry.command]);
         else
-            entry.execute();
+            root.launchInScope(entry, entry.command);
     }
