+    function isTaskbarToplevel(client: var): bool {
+        if (!client)
+            return false;
+
+        const w = client.lastIpcObject ?? {};
+        const cls = w.class ?? "";
+        const initialClass = w.initialClass ?? "";
+        const title = w.title ?? "";
+        const initialTitle = w.initialTitle ?? "";
+
+        if ((w.xwayland ?? false) && cls === "" && title === "")
+            return false;
+
+        if (/^(QtWebEngineProcess\.exe|QtWebEngineProcess)$/.test(cls) || /^(QtWebEngineProcess\.exe|QtWebEngineProcess)$/.test(initialClass))
+            return false;
+
+        if (/^(Wine System Tray|System Tray|Qt Tray Icon Window|TrayWindow|win[0-9]+)$/i.test(title))
+            return false;
+
+        if (/^(Wine System Tray|System Tray|Qt Tray Icon Window|TrayWindow|win[0-9]+)$/i.test(initialTitle))
+            return false;
+
+        return true;
+    }
