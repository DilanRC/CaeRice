#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
from pathlib import Path

TOOLS = ["steam", "gamescope", "gamemoderun", "gamemoded", "mangohud", "nvidia-smi", "wine", "winetricks", "prime-run"]


def run(command: list[str], timeout: float = 3.0) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(command, text=True, capture_output=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def steam_roots() -> list[Path]:
    candidates = [Path.home() / ".local/share/Steam", Path.home() / ".steam/steam"]
    out: list[Path] = []
    seen: set[str] = set()
    for path in candidates:
        try:
            resolved = path.resolve()
        except OSError:
            resolved = path
        if resolved.exists() and str(resolved) not in seen:
            seen.add(str(resolved)); out.append(resolved)
    for root in list(out):
        vdf = root / "steamapps/libraryfolders.vdf"
        try:
            text = vdf.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for raw in re.findall(r'"path"\s+"([^"]+)"', text):
            path = Path(raw.replace("\\\\", "\\"))
            if path.exists() and str(path) not in seen:
                seen.add(str(path)); out.append(path)
    return out


def parse_manifest(path: Path) -> dict | None:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    def field(name: str) -> str:
        match = re.search(rf'"{re.escape(name)}"\s+"([^"]*)"', text)
        return match.group(1) if match else ""
    appid = field("appid")
    name = field("name")
    if not appid or not name:
        return None
    try:
        size = int(field("SizeOnDisk") or 0)
    except ValueError:
        size = 0
    return {
        "appid": appid,
        "name": name,
        "installdir": field("installdir"),
        "buildid": field("buildid"),
        "stateflags": field("StateFlags"),
        "size_gb": round(size / (1024 ** 3), 2),
        "manifest": str(path),
        "library": str(path.parent.parent),
    }


def installed_games(roots: list[Path]) -> list[dict]:
    games: dict[str, dict] = {}
    for root in roots:
        steamapps = root / "steamapps" if root.name != "steamapps" else root
        if not steamapps.is_dir():
            steamapps = root / "steamapps"
        for path in steamapps.glob("appmanifest_*.acf") if steamapps.is_dir() else []:
            item = parse_manifest(path)
            if item:
                games[item["appid"]] = item
    return sorted(games.values(), key=lambda item: item["name"].lower())


def proton_versions(roots: list[Path]) -> list[dict]:
    out: list[dict] = []
    seen: set[str] = set()
    for root in roots:
        for base in [root / "steamapps/common", root / "compatibilitytools.d"]:
            if not base.is_dir():
                continue
            for child in sorted(base.iterdir()):
                low = child.name.lower()
                if not child.is_dir() or not (low.startswith("proton") or "ge-proton" in low):
                    continue
                key = str(child)
                if key in seen:
                    continue
                seen.add(key)
                out.append({"name": child.name, "path": key, "custom": "compatibilitytools.d" in key})
    return out[:80]


def nvidia() -> dict:
    exe = shutil.which("nvidia-smi")
    if not exe:
        return {"available": False}
    cp = run([exe, "--query-gpu=name,driver_version,memory.used,memory.total,utilization.gpu,temperature.gpu,pstate,power.draw", "--format=csv,noheader,nounits"], 3)
    if not cp or cp.returncode != 0:
        return {"available": True, "query_ok": False}
    rows = []
    for line in cp.stdout.splitlines():
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 8:
            continue
        def num(index: int):
            try: return float(parts[index])
            except ValueError: return None
        rows.append({"name": parts[0], "driver": parts[1], "vram_used_mib": num(2), "vram_mib": num(3), "usage": num(4), "temp_c": num(5), "pstate": parts[6], "power_w": num(7)})
    return {"available": True, "query_ok": True, "gpus": rows}


def related_processes() -> list[dict]:
    out = []
    tokens = ["steam", "gamescope", "wine", "proton", "mangohud", "gamemode", "pressure-vessel"]
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            comm = (proc / "comm").read_text(errors="replace").strip()
            cmdline = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
            envraw = (proc / "environ").read_bytes().replace(b"\0", b"\n").decode(errors="replace")
        except OSError:
            continue
        haystack = f"{comm} {cmdline}".lower()
        env = {}
        for line in envraw.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                if k in {"SteamAppId", "SteamGameId", "MANGOHUD", "GAMEMODERUNEXEC", "__NV_PRIME_RENDER_OFFLOAD", "DRI_PRIME"}:
                    env[k] = v
        if not env.get("SteamAppId") and not any(token in haystack for token in tokens):
            continue
        out.append({"pid": int(proc.name), "name": comm, "command": cmdline[:700], "steam_appid": env.get("SteamAppId") or env.get("SteamGameId") or "", "env": env})
    return sorted(out, key=lambda item: (not bool(item["steam_appid"]), item["name"].lower()))[:120]


def gamemode_status() -> dict:
    exe = shutil.which("gamemoded")
    if not exe:
        return {"available": False}
    cp = run([exe, "-s"], 2)
    if not cp:
        return {"available": True, "active": None}
    text = (cp.stdout + cp.stderr).strip()
    return {"available": True, "active": cp.returncode == 0 and "inactive" not in text.lower(), "text": text[:240]}


def main() -> None:
    roots = steam_roots()
    payload = {
        "tools": {name: shutil.which(name) for name in TOOLS},
        "steam_roots": [str(path) for path in roots],
        "installed_games": installed_games(roots),
        "proton_versions": proton_versions(roots),
        "nvidia": nvidia(),
        "gamemode": gamemode_status(),
        "running_related": related_processes(),
        "session": {"wayland_display": os.environ.get("WAYLAND_DISPLAY", ""), "desktop": os.environ.get("XDG_CURRENT_DESKTOP", ""), "xdg_session_type": os.environ.get("XDG_SESSION_TYPE", "")},
        "profile_capability": True,
        "launch_capability": bool(shutil.which("steam")),
        "safety": "profiles are per-game and reversible; no clocks, voltages, fan curves, anti-cheat bypasses or global GPU power changes",
    }
    print(json.dumps(payload, separators=(",", ":")))


if __name__ == "__main__":
    main()
