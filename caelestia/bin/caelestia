#!/usr/bin/env bash
set -euo pipefail

runtime_root="${CORTETSU_RUNTIME_ROOT:-${CAERICE_RUNTIME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/caelestia}}"
runtime="$runtime_root/current"

if [[ "${1:-}" == "record" && -x "$HOME/.local/lib/caelestia-record-fixed.py" ]]; then
    shift
    exec "$HOME/.local/lib/caelestia-record-fixed.py" "$@"
fi

# Route packaged region-screenshot IPC to Cortetsu's promoted user generation.
if [[ -f "$runtime/shell.qml" && "${1:-}" == "screenshot" && " $* " == *" -r "* ]]; then
    if [[ " $* " == *" -f "* || " $* " == *" --freeze "* ]]; then
        exec qs -p "$runtime" ipc call picker openFreeze
    fi
    exec qs -p "$runtime" ipc call picker open
fi

[[ -x /usr/bin/caelestia ]] || {
    echo "ERROR: /usr/bin/caelestia no existe" >&2
    exit 127
}
exec /usr/bin/caelestia "$@"
