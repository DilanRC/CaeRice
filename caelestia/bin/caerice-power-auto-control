#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

UID = os.getuid()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{UID}"))
CONFIG_PATH = Path.home() / ".config/caerice/power-auto.json"
STATE_PATH = RUNTIME / "caerice-power-auto-state.json"
SERVICE = "caerice-power-auto.service"
VALID_PROFILES = {"power-saver", "balanced", "performance"}
DEFAULTS = {
    "enabled": False,
    "ac_profile": "performance",
    "battery_profile": "balanced",
    "low_battery_enabled": True,
    "low_battery_threshold": 25,
    "low_battery_profile": "power-saver",
    "poll_seconds": 4,
}


def load_json(path: Path, default):
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
        return parsed if isinstance(parsed, type(default)) else default
    except (OSError, json.JSONDecodeError):
        return default


def load_config() -> dict:
    cfg = dict(DEFAULTS)
    parsed = load_json(CONFIG_PATH, {})
    cfg.update(parsed)
    return cfg


def save_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONFIG_PATH)


def systemctl(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["systemctl", "--user", *args],
        text=True,
        capture_output=True,
        timeout=8,
        check=False,
    )


def bool_arg(value: str) -> bool:
    lowered = value.lower()
    if lowered in {"1", "true", "yes", "on", "enabled"}:
        return True
    if lowered in {"0", "false", "no", "off", "disabled"}:
        return False
    raise ValueError("expected true/false")


def status() -> dict:
    cfg = load_config()
    active = systemctl("is-active", SERVICE).returncode == 0
    enabled = systemctl("is-enabled", SERVICE).returncode == 0
    state = load_json(STATE_PATH, {})
    return {
        "config": cfg,
        "service": {"active": active, "enabled": enabled, "name": SERVICE},
        "last": state,
    }


def emit(payload: dict, code: int = 0) -> int:
    print(json.dumps(payload, separators=(",", ":")))
    return code


def refresh_service(cfg: dict) -> None:
    if cfg.get("enabled", False):
        systemctl("try-restart", SERVICE)


def main() -> int:
    cfg = load_config()
    if len(sys.argv) == 1 or sys.argv[1] == "status":
        save_config(cfg)
        return emit(status())

    cmd = sys.argv[1]
    try:
        if cmd == "set-enabled" and len(sys.argv) >= 3:
            enabled = bool_arg(sys.argv[2])
            cfg["enabled"] = enabled
            save_config(cfg)
            systemctl("daemon-reload")
            cp = systemctl("enable", "--now", SERVICE) if enabled else systemctl("disable", "--now", SERVICE)
            if cp.returncode != 0:
                return emit({"ok": False, "error": (cp.stderr or cp.stdout).strip(), **status()}, cp.returncode or 2)
            return emit({"ok": True, **status()})

        if cmd == "set-profile" and len(sys.argv) >= 4:
            slot, profile = sys.argv[2], sys.argv[3]
            keys = {"ac": "ac_profile", "battery": "battery_profile", "low": "low_battery_profile"}
            if slot not in keys or profile not in VALID_PROFILES:
                return emit({"ok": False, "error": "invalid slot/profile"}, 2)
            cfg[keys[slot]] = profile
            save_config(cfg)
            refresh_service(cfg)
            return emit({"ok": True, **status()})

        if cmd == "set-low-enabled" and len(sys.argv) >= 3:
            cfg["low_battery_enabled"] = bool_arg(sys.argv[2])
            save_config(cfg)
            refresh_service(cfg)
            return emit({"ok": True, **status()})

        if cmd == "set-threshold" and len(sys.argv) >= 3:
            threshold = max(5, min(80, int(sys.argv[2])))
            cfg["low_battery_threshold"] = threshold
            save_config(cfg)
            refresh_service(cfg)
            return emit({"ok": True, **status()})

        if cmd == "apply-now":
            watcher = Path.home() / ".local/bin/caerice-power-auto"
            cp = subprocess.run([str(watcher), "--once"], text=True, capture_output=True, timeout=10, check=False)
            return emit({"ok": cp.returncode == 0, "watcher_stdout": cp.stdout.strip(), "watcher_stderr": cp.stderr.strip(), **status()}, cp.returncode)
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        return emit({"ok": False, "error": str(exc)}, 2)

    return emit({"ok": False, "error": "unknown command"}, 2)


if __name__ == "__main__":
    raise SystemExit(main())
