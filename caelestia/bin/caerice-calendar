#!/usr/bin/env python3
"""Read-only Google Calendar bridge for CaeRice.

The module intentionally exposes only CalendarList.list and Events.list.
Tokens are stored in Secret Service; cache/config never contain credentials.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import http.server
import json
import os
import secrets
import socket
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from datetime import datetime, timezone
from pathlib import Path

SCOPES = (
    "https://www.googleapis.com/auth/calendar.events.readonly",
    "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
)
AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
API_ROOT = "https://www.googleapis.com/calendar/v3"
SERVICE = "caerice-google-calendar"
STALE_SECONDS = 900


def paths() -> tuple[Path, Path, Path]:
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "caelestia"
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "caelestia"
    return config / "calendar-client.json", config / "calendar-selection.json", cache / "calendar-events.json"


def secret_get() -> str | None:
    p = subprocess.run(["secret-tool", "lookup", "service", SERVICE], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else None


def secret_set(token: str) -> None:
    subprocess.run(["secret-tool", "store", "--label", "CaeRice Google Calendar refresh token", "service", SERVICE], input=token, text=True, check=True)


def secret_clear() -> None:
    subprocess.run(["secret-tool", "clear", "service", SERVICE], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, ValueError, OSError):
        return default


def normalize_client(raw) -> tuple[dict | None, str | None]:
    """Accept Google's Desktop ``installed`` document or the flat test form."""
    if not isinstance(raw, dict) or not raw:
        return None, "credential_error"
    if "installed" in raw:
        client = raw["installed"]
        if not isinstance(client, dict):
            return None, "credential_error"
    elif "web" in raw:
        return None, "credential_error"
    else:
        client = raw
    if not isinstance(client.get("client_id"), str) or not client["client_id"].strip():
        return None, "credential_error"
    return client, None


def save_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    tmp.chmod(0o600)
    tmp.replace(path)


def api_get(access_token: str, path: str, params: dict) -> dict:
    url = API_ROOT + path + "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {access_token}"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def refresh_access(client: dict, refresh_token: str) -> str:
    body = urllib.parse.urlencode({"client_id": client["client_id"], "client_secret": client.get("client_secret", ""), "refresh_token": refresh_token, "grant_type": "refresh_token"}).encode()
    request = urllib.request.Request(TOKEN_URL, data=body, method="POST")
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)["access_token"]


class Callback(http.server.BaseHTTPRequestHandler):
    code = None
    def do_GET(self):  # noqa: N802
        Callback.code = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("code", [None])[0]
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"CaeRice authorization received. You can close this tab.")
    def log_message(self, *_):
        return


def authorize(client: dict) -> str:
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    server = http.server.HTTPServer(("127.0.0.1", 0), Callback)
    redirect = f"http://127.0.0.1:{server.server_port}/oauth2callback"
    query = {"client_id": client["client_id"], "redirect_uri": redirect, "response_type": "code", "scope": " ".join(SCOPES), "access_type": "offline", "prompt": "consent", "code_challenge": challenge, "code_challenge_method": "S256"}
    webbrowser.open(AUTH_URL + "?" + urllib.parse.urlencode(query))
    server.timeout = 300
    while Callback.code is None:
        server.handle_request()
    code = Callback.code
    server.server_close()
    body = urllib.parse.urlencode({"client_id": client["client_id"], "client_secret": client.get("client_secret", ""), "code": code, "code_verifier": verifier, "grant_type": "authorization_code", "redirect_uri": redirect}).encode()
    request = urllib.request.Request(TOKEN_URL, data=body, method="POST")
    with urllib.request.urlopen(request, timeout=20) as response:
        token = json.load(response)
    secret_set(token["refresh_token"])
    return token["access_token"]


def token(client: dict) -> str:
    refresh = secret_get()
    return refresh_access(client, refresh) if refresh else authorize(client)


def calendar_list(access: str) -> list[dict]:
    result, page = [], None
    while True:
        params = {"maxResults": 250}
        if page: params["pageToken"] = page
        data = api_get(access, "/users/me/calendarList", params)
        result.extend({"calendarId": x["id"], "calendarName": x.get("summary", x["id"]), "calendarColor": x.get("backgroundColor", ""), "selected": bool(x.get("selected", False)), "primary": bool(x.get("primary", False))} for x in data.get("items", []))
        page = data.get("nextPageToken")
        if not page: return result


def events(access: str, calendars: list[dict], start: str, end: str, tz: str) -> tuple[list[dict], list[dict]]:
    all_events, failures = [], []
    for cal in calendars:
        try:
            page = None
            while True:
                params = {"singleEvents": "true", "showDeleted": "false", "orderBy": "startTime", "timeMin": start, "timeMax": end, "timeZone": tz, "maxResults": 2500}
                if page: params["pageToken"] = page
                data = api_get(access, "/calendars/" + urllib.parse.quote(cal["calendarId"], safe="") + "/events", params)
                for item in data.get("items", []):
                    begin, finish = item.get("start", {}), item.get("end", {})
                    all_events.append({"calendarId": cal["calendarId"], "calendarName": cal["calendarName"], "calendarColor": cal["calendarColor"], "eventId": item["id"], "title": item.get("summary", "(untitled)"), "start": begin.get("dateTime", begin.get("date")), "end": finish.get("dateTime", finish.get("date")), "allDay": "date" in begin, "location": item.get("location", ""), "htmlLink": item.get("htmlLink", "")})
                page = data.get("nextPageToken")
                if not page: break
        except (urllib.error.URLError, urllib.error.HTTPError, KeyError, ValueError) as exc:
            failures.append({"calendarId": cal["calendarId"], "error": type(exc).__name__})
    return all_events, failures


def sync() -> int:
    client_path, selection_path, cache_path = paths()
    if not client_path.exists():
        print(json.dumps({"status": "auth_required", "clientPath": str(client_path)})); return 2
    client, credential_error = normalize_client(load_json(client_path, {}))
    if credential_error:
        print(json.dumps({"status": credential_error, "clientPath": str(client_path)})); return 2
    try:
        access = token(client)
        calendars = calendar_list(access)
    except (urllib.error.URLError, urllib.error.HTTPError, KeyError, ValueError, subprocess.SubprocessError) as exc:
        print(json.dumps({"status": "error", "error": type(exc).__name__})); return 3
    selection = load_json(selection_path, {})
    enabled = selection.get("enabled")
    if not isinstance(enabled, list):
        enabled = [x["calendarId"] for x in calendars if x["selected"] or x["primary"]]
        save_json(selection_path, {"enabled": enabled})
    chosen = [x for x in calendars if x["calendarId"] in enabled]
    now = datetime.now().astimezone()
    start, end = now.isoformat(), (now.timestamp() + 30 * 86400)
    end_iso = datetime.fromtimestamp(end, now.tzinfo).isoformat()
    items, failures = events(access, chosen, start, end_iso, str(now.tzinfo))
    payload = {"fetchedAt": time.time(), "timezone": str(now.tzinfo), "calendars": calendars, "events": items, "failures": failures}
    save_json(cache_path, payload)
    print(json.dumps({"status": "ok", "cache": str(cache_path), "eventCount": len(items), "failedCalendars": failures}))
    return 0 if not failures else 4


def set_selection(calendar_id: str, enabled: bool) -> int:
    _, selection_path, _ = paths()
    selection = load_json(selection_path, {"enabled": [], "initialized": True})
    ids = set(selection.get("enabled", []))
    (ids.add if enabled else ids.discard)(calendar_id)
    save_json(selection_path, {"enabled": sorted(ids), "initialized": True})
    print(json.dumps({"status": "selection_updated", "enabled": sorted(ids)}))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=["sync", "disconnect", "scopes", "set-selection"])
    parser.add_argument("calendar_id", nargs="?")
    parser.add_argument("enabled", nargs="?", choices=["true", "false"])
    args = parser.parse_args()
    if args.command == "scopes": print("\n".join(SCOPES)); return 0
    if args.command == "disconnect": secret_clear(); return 0
    if args.command == "set-selection":
        if not args.calendar_id or args.enabled is None: return 2
        return set_selection(args.calendar_id, args.enabled == "true")
    return sync()


if __name__ == "__main__": raise SystemExit(main())
