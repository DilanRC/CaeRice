#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import subprocess
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
LIVE = Path("/etc/xdg/quickshell/caelestia")
BASE_INFO = REPO / "caelestia/PATCH_BASE_INFO.txt"
PATCH_DIR = REPO / "caelestia/patches"
MANIFEST = PATCH_DIR / "MANIFEST.tsv"
CUSTOM_BASE = Path.home() / ".local/share/caelestia-custom-system"


def run(*args: str, cwd: Path | None = None, timeout: int = 8) -> dict:
    try:
        cp = subprocess.run(args, cwd=cwd, text=True, capture_output=True, timeout=timeout, check=False)
        return {"code": cp.returncode, "stdout": cp.stdout.strip(), "stderr": cp.stderr.strip()}
    except (OSError, subprocess.SubprocessError) as exc:
        return {"code": 127, "stdout": "", "stderr": str(exc)}


def packages() -> dict:
    out = {}
    for pkg in ["caelestia-shell", "caelestia", "caelestia-cli", "quickshell"]:
        cp = run("pacman", "-Q", pkg)
        if cp["code"] == 0:
            parts = cp["stdout"].split(maxsplit=1)
            out[pkg] = parts[1] if len(parts) > 1 else cp["stdout"]
    return out


def base_info() -> dict:
    out = {}
    try: lines = BASE_INFO.read_text(encoding="utf-8").splitlines()
    except OSError: return out
    for line in lines:
        if "=" in line:
            key, value = line.split("=", 1); out[key.strip()] = value.strip()
    return out


def git_state() -> dict:
    return {
        "branch": run("git", "branch", "--show-current", cwd=REPO)["stdout"],
        "head": run("git", "rev-parse", "HEAD", cwd=REPO)["stdout"],
        "status": run("git", "status", "--porcelain", cwd=REPO)["stdout"].splitlines(),
        "origin": run("git", "remote", "get-url", "origin", cwd=REPO)["stdout"],
    }


def manifest() -> list[dict]:
    rows = []
    try: lines = MANIFEST.read_text(encoding="utf-8").splitlines()[1:]
    except OSError: lines = []
    for line in lines:
        parts = line.split("\t")
        if len(parts) >= 2:
            patch, target = parts[0], parts[1]
            path = PATCH_DIR / patch
            rows.append({"patch": patch, "target": target, "bytes": path.stat().st_size if path.exists() else 0})
    return rows


def sha(path: Path) -> str:
    try: return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError: return ""


def live_targets(rows: list[dict]) -> list[dict]:
    return [{"target": row["target"], "exists": (LIVE / row["target"]).is_file(), "sha256": sha(LIVE / row["target"])} for row in rows]


def main() -> None:
    rows = manifest()
    payload = {
        "packages": packages(),
        "patch_base": base_info(),
        "git": git_state(),
        "live_tree_present": LIVE.is_dir(),
        "patches": rows,
        "live_targets": live_targets(rows),
        "cache_root": str(Path.home() / ".cache/caerice-updater"),
        "snapshot_root": str(CUSTOM_BASE / "snapshots"),
        "pipeline": ["discover", "fetch", "test", "review", "package-update-separate", "snapshot", "apply", "verify", "commit-base", "rollback"],
        "safety": "package updates are deliberately separate from CaeRice patch application; apply requires a clean dry-run and a live tree matching the tested candidate",
    }
    print(json.dumps(payload, separators=(",", ":")))


if __name__ == "__main__": main()
