#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

CONFIG = Path.home() / ".config/caerice/gaming-profiles.json"
STATE = Path.home() / ".local/state/caerice/gaming-last-open.json"
ALLOWED_GPU = {"default", "integrated", "nvidia"}
ALLOWED_SCALERS = {"auto", "integer", "fit", "fill", "stretch"}
ALLOWED_FILTERS = {"linear", "nearest", "fsr", "nis", "pixel"}


def emit(payload: dict, code: int = 0) -> int:
    print(json.dumps(payload, separators=(",", ":"), ensure_ascii=False))
    return code


def canonical_appid(value: str) -> str:
    # Steam AppIDs are the profile key, the persisted state, and the literal
    # `steam -applaunch <appid>` argument. `str.isdigit()`/`str.isnumeric()`
    # accept Unicode digit classes (e.g. full-width "１２３") that `int()`
    # happily parses too - not what "Steam AppID" means here, and a gap that
    # would let the same game exist as two unrelated profiles depending on
    # which digit variant was typed. `isdecimal()` restricts to values whose
    # digits form a normal base-10 number, and `isascii()` additionally
    # excludes non-ASCII decimal digit scripts entirely. Canonicalizing
    # leading zeros (int() round-trip) closes the "123" vs "00123" duplicate-
    # profile gap called out in the same finding.
    text = str(value)
    if not text or not text.isascii() or not text.isdecimal():
        raise ValueError("appid must contain ASCII decimal digits only")
    number = int(text, 10)
    if number < 1 or number > 0xFFFFFFFF:
        raise ValueError("appid must be a positive 32-bit Steam AppID")
    return str(number)


def load() -> dict:
    try:
        data = json.loads(CONFIG.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {"version": 3, "profiles": {}}
    except (OSError, json.JSONDecodeError):
        return {"version": 3, "profiles": {}}


def atomic_write(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, separators=(",", ":"), ensure_ascii=False)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def normalize(appid: str, name: str, raw: dict) -> dict:
    def integer(key: str, default: int, low: int, high: int) -> int:
        try:
            value = int(raw.get(key, default))
        except (TypeError, ValueError):
            value = default
        return max(low, min(high, value))

    gpu = str(raw.get("gpu", "default"))
    if gpu not in ALLOWED_GPU:
        gpu = "default"
    scaler = str(raw.get("scaler", "auto"))
    if scaler not in ALLOWED_SCALERS:
        scaler = "auto"
    filter_name = str(raw.get("filter", "linear"))
    if filter_name not in ALLOWED_FILTERS:
        filter_name = "linear"

    output_width = integer("output_width", integer("width", 0, 0, 7680), 0, 7680)
    output_height = integer("output_height", integer("height", 0, 0, 4320), 0, 4320)
    default_gamemode = bool(shutil.which("gamemoderun"))

    return {
        "appid": str(appid),
        "name": str(name or raw.get("name") or appid),
        "gamemode": bool(raw.get("gamemode", default_gamemode)),
        "mangohud": bool(raw.get("mangohud", False)),
        "gamescope": bool(raw.get("gamescope", False)),
        "gpu": gpu,
        "fps_cap": integer("fps_cap", 0, 0, 360),
        "game_width": integer("game_width", 0, 0, 7680),
        "game_height": integer("game_height", 0, 0, 4320),
        "output_width": output_width,
        "output_height": output_height,
        "scaler": scaler,
        "filter": filter_name,
        "sharpness": integer("sharpness", -1, -1, 20),
        "adaptive_sync": bool(raw.get("adaptive_sync", False)),
        "fullscreen": bool(raw.get("fullscreen", True)),
        "updated": int(time.time()),
    }


def require_tools(profile: dict) -> list[str]:
    missing: list[str] = []
    if profile.get("gamescope") and not shutil.which("gamescope"):
        missing.append("gamescope")
    if profile.get("gamemode") and not shutil.which("gamemoderun"):
        missing.append("gamemoderun")
    if profile.get("mangohud") and not profile.get("gamescope") and not shutil.which("mangohud"):
        missing.append("mangohud")
    return missing


def shell_join(tokens: list[str]) -> str:
    return " ".join(token if token == "%command%" else shlex.quote(token) for token in tokens)


def launch_options(profile: dict) -> tuple[str, list[str], dict[str, str]]:
    missing = require_tools(profile)
    if missing:
        raise RuntimeError("profile requires unavailable tool(s): " + ", ".join(missing))

    env: dict[str, str] = {}
    gpu = profile.get("gpu", "default")
    if gpu == "nvidia":
        env.update({
            "__NV_PRIME_RENDER_OFFLOAD": "1",
            "__GLX_VENDOR_LIBRARY_NAME": "nvidia",
            "__VK_LAYER_NV_optimus": "NVIDIA_only",
        })
    elif gpu == "integrated":
        env["DRI_PRIME"] = "0"

    command: list[str] = ["%command%"]
    wrappers: list[str] = []

    if profile.get("gamescope"):
        gs = ["gamescope"]
        game_width = int(profile.get("game_width") or 0)
        game_height = int(profile.get("game_height") or 0)
        output_width = int(profile.get("output_width") or 0)
        output_height = int(profile.get("output_height") or 0)
        fps = int(profile.get("fps_cap") or 0)
        scaler = str(profile.get("scaler") or "auto")
        filter_name = str(profile.get("filter") or "linear")
        sharpness = int(profile.get("sharpness", -1))
        if game_width:
            gs += ["-w", str(game_width)]
        if game_height:
            gs += ["-h", str(game_height)]
        if output_width:
            gs += ["-W", str(output_width)]
        if output_height:
            gs += ["-H", str(output_height)]
        if fps:
            gs += ["-r", str(fps)]
        if scaler != "auto":
            gs += ["-S", scaler]
        if filter_name != "linear":
            gs += ["-F", filter_name]
        if sharpness >= 0 and filter_name in {"fsr", "nis"}:
            gs += ["--sharpness", str(sharpness)]
        if profile.get("adaptive_sync"):
            gs += ["--adaptive-sync"]
        if profile.get("mangohud"):
            gs += ["--mangoapp"]
            wrappers.append("mangoapp")
        if profile.get("fullscreen"):
            gs += ["-f"]
        command = gs + ["--", "%command%"]
        wrappers.insert(0, "gamescope")
    elif profile.get("mangohud"):
        command = ["mangohud", "%command%"]
        wrappers.append("mangohud")

    if profile.get("gamemode"):
        command = ["gamemoderun"] + command
        wrappers.insert(0, "gamemode")

    if env:
        command = ["env"] + [f"{key}={value}" for key, value in env.items()] + command
        wrappers.insert(0, "gpu-env")

    return shell_join(command), wrappers, env


def get_profile(appid: str, name: str = "") -> dict:
    data = load()
    raw = data.get("profiles", {}).get(str(appid), {}) if isinstance(data.get("profiles"), dict) else {}
    return normalize(appid, name or str(raw.get("name", "")), raw)


def profile_payload(profile: dict) -> dict:
    try:
        options, wrappers, env = launch_options(profile)
        return {"profile": profile, "launch_options": options, "wrappers": wrappers, "env": env, "ready": True, "error": ""}
    except RuntimeError as exc:
        return {"profile": profile, "launch_options": "", "wrappers": [], "env": {}, "ready": False, "error": str(exc)}


def copy_options(profile: dict) -> tuple[dict, int]:
    options, wrappers, env = launch_options(profile)
    wl_copy = shutil.which("wl-copy")
    if not wl_copy:
        return {"ok": False, "error": "wl-copy is not installed", "launch_options": options}, 2
    cp = subprocess.run([wl_copy], input=options, text=True, capture_output=True, timeout=5, check=False)
    if cp.returncode != 0:
        return {"ok": False, "error": (cp.stderr or cp.stdout).strip(), "launch_options": options}, 3
    return {"ok": True, "copied": True, "launch_options": options, "wrappers": wrappers, "env": env}, 0


def open_game(profile: dict) -> tuple[dict, int]:
    steam = shutil.which("steam")
    if not steam:
        return {"ok": False, "error": "steam is not installed"}, 2
    proc = subprocess.Popen(
        [steam, "-applaunch", str(profile["appid"])],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    atomic_write(STATE, {"appid": profile["appid"], "name": profile["name"], "pid": proc.pid, "opened": int(time.time())})
    return {
        "ok": True,
        "opened": True,
        "pid": proc.pid,
        "profile": profile,
        "profile_applied_by_this_launch": False,
        "note": "Steam opened normally; copy the generated launch options into the game's Steam properties to activate the profile",
    }, 0


def main() -> int:
    parser = argparse.ArgumentParser(description="CaeRice safe per-game Steam launch-option profiles")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    getp = sub.add_parser("get"); getp.add_argument("--appid", required=True); getp.add_argument("--name", default="")
    setp = sub.add_parser("set"); setp.add_argument("--appid", required=True); setp.add_argument("--name", default=""); setp.add_argument("--json", required=True)
    deletep = sub.add_parser("delete"); deletep.add_argument("--appid", required=True)
    commandp = sub.add_parser("command"); commandp.add_argument("--appid", required=True); commandp.add_argument("--name", default="")
    copyp = sub.add_parser("copy"); copyp.add_argument("--appid", required=True); copyp.add_argument("--name", default="")
    openp = sub.add_parser("open"); openp.add_argument("--appid", required=True); openp.add_argument("--name", default="")
    args = parser.parse_args()

    try:
        if args.command != "list":
            args.appid = canonical_appid(args.appid)
        data = load()
        profiles = data.setdefault("profiles", {})
        if args.command == "list":
            items = []
            for appid, raw in profiles.items():
                if isinstance(raw, dict):
                    items.append(profile_payload(normalize(appid, str(raw.get("name", "")), raw)))
            return emit({"ok": True, "profiles": sorted(items, key=lambda x: x["profile"]["name"].lower()), "config": str(CONFIG), "schema": 3, "steam_vdf_mutation": False})
        if args.command == "get":
            profile = get_profile(args.appid, args.name)
            return emit({"ok": True, **profile_payload(profile), "steam_vdf_mutation": False})
        if args.command == "set":
            raw = json.loads(args.json)
            if not isinstance(raw, dict):
                raise ValueError("profile JSON must be an object")
            profile = normalize(args.appid, args.name, raw)
            payload = profile_payload(profile)
            if not payload["ready"]:
                return emit({"ok": False, **payload}, 3)
            profiles[str(args.appid)] = profile
            data["version"] = 3
            atomic_write(CONFIG, data)
            return emit({"ok": True, "saved": True, **payload, "steam_vdf_mutation": False})
        if args.command == "delete":
            removed = profiles.pop(str(args.appid), None) is not None
            data["version"] = 3
            atomic_write(CONFIG, data)
            return emit({"ok": True, "deleted": removed})

        profile = get_profile(args.appid, args.name)
        if args.command == "command":
            payload = profile_payload(profile)
            return emit({"ok": payload["ready"], **payload, "steam_vdf_mutation": False}, 0 if payload["ready"] else 3)
        if args.command == "copy":
            payload, code = copy_options(profile)
            payload["steam_vdf_mutation"] = False
            return emit(payload, code)
        if args.command == "open":
            payload, code = open_game(profile)
            payload["steam_vdf_mutation"] = False
            return emit(payload, code)
    except (ValueError, json.JSONDecodeError, OSError, RuntimeError, subprocess.SubprocessError) as exc:
        return emit({"ok": False, "error": str(exc)}, 2)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
